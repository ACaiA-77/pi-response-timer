{
  "name": "pi-response-timer",
  "version": "0.1.1",
  "description": "Live elapsed time and a minimal completion timestamp for Pi's terminal UI.",
  "type": "module",
  "license": "MIT",
  "author": "ACaiA-77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACaiA-77/pi-response-timer.git"
  },
  "homepage": "https://github.com/ACaiA-77/pi-response-timer#readme",
  "bugs": "https://github.com/ACaiA-77/pi-response-timer/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "timer",
    "timestamp"
  ],
  "files": [
